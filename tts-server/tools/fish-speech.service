[Unit]
Description=Fish-Speech S2 Pro API server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/fish-speech
# expandable_segments lets PyTorch grow the allocator without pre-reserving
# a contiguous block — critical on the shared 3090 where Chatterbox/GSV/ollama
# also live. Without this, fragmentation OOMs Fish during model load.
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# S2 Pro is ~4.4B params at fp16 and uses ~7-8 GiB VRAM without torch.compile.
# Do not add --compile here: its startup working set exceeds CT 110's 12 GiB
# RAM limit before the model reaches the GPU, which can wedge the entire TTS
# API in an OOM/restart loop.
ExecStart=/opt/fish-speech/.venv/bin/python -m tools.api_server \
    --mode tts \
    --llama-checkpoint-path checkpoints/s2-pro \
    --decoder-checkpoint-path checkpoints/s2-pro/codec.pth \
    --decoder-config-name modded_dac_vq \
    --listen 0.0.0.0:8881 \
    --device cuda \
    --half
# tts-server starts Fish lazily on the next Fish request. Do not automatically
# restart an OOM-killed loader; that just repeats the allocation and starves
# every other TTS engine.
Restart=no
# Fish/Uvicorn can swallow SIGTERM while model loading. Bound the stop so
# release-gpu and readiness cleanup always reclaim memory promptly.
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
